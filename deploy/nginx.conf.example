server {
    # 工作台 nginx 站点示例 — 按实际环境修改后放入 /etc/nginx/sites-enabled/
    # 监听端口、静态根目录按需调整; 不要将此文件原样用于生产。
    listen 8080;
    server_name _;
    root /var/www/hermes-report;   # 静态站点根目录 (build.py 产物 kanban.html + avatars/)
    index index.html;

    # workbench API 反代 → 本机 workbench-api (默认 127.0.0.1:8081)
    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }

    # SSE 事件流: 关缓冲+长超时+HTTP/1.1 (缺失会导致流式更新静默失效)
    location /api/v1/stream {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }
}
