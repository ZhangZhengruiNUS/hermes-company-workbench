# Workbench 环境配置示例 — 复制为 .env 并按实际环境填写; 不要提交真实 .env
# 所有项均有默认值, 不配置也能以默认行为启动(仅本机访问)。

# Hermes 数据目录 (kanban.db / projects.db / profiles 所在处)
WORKBENCH_HERMES_HOME=~/.hermes

# API 监听端口 (默认 8081, 仅监听 127.0.0.1)
WORKBENCH_PORT=8081

# 写解锁密码。不设置时服务端首次启动会自动生成随机密码并写入
# $WORKBENCH_HERMES_HOME/backups/workbench_write_password (0600, 仅 owner 可读)。
# 生产环境建议显式设置强密码。
#WORKBENCH_WRITE_PASSWORD=

# nginx 站点: 参考 deploy/nginx.conf.example, 静态根目录与反代端口按需修改。
